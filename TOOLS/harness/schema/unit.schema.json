{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gustavodvp/engineering-harness/schema/unit.schema.json",
  "title": "Harness knowledge unit (SKILL.md, RULE.md, WORKFLOW.md, AGENT.md)",
  "description": "Agent Skills compatible frontmatter (agentskills.io/specification). Harness fields live under metadata as string values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "metadata"],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "license": {"type": "string", "minLength": 1},
    "compatibility": {"type": "string", "minLength": 1, "maxLength": 500},
    "allowed-tools": {"type": "string"},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "propertyNames": {"pattern": "^(harness\\.[a-z-]+|[a-z][a-z0-9_.-]*)$"},
      "required": ["harness.type", "harness.scope", "harness.version", "harness.status"],
      "properties": {
        "harness.type": {"enum": ["skill", "rule", "workflow", "agent"]},
        "harness.scope": {"enum": ["generic", "profile"]},
        "harness.profile": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "harness.version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "harness.status": {"enum": ["draft", "active", "deprecated"]},
        "harness.enforcement": {"enum": ["mandatory", "default"]},
        "harness.applies-to": {"type": "string", "pattern": "^\\s*(task|stack)\\s*:[^;]+(;\\s*(task|stack)\\s*:[^;]+)*;?\\s*$"},
        "harness.decides": {"type": "string", "pattern": "^\\s*[a-z0-9.-]+=[^;=]+(;\\s*[a-z0-9.-]+=[^;=]+)*;?\\s*$"},
        "harness.overrides": {"type": "string"},
        "harness.sources": {"type": "string"},
        "harness.reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "harness.tags": {"type": "string"},
        "harness.supersedes": {"type": "string"}
      }
    }
  }
}
